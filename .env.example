# Stream Keys Template
# Copy values to /etc/credstore/ and fill in actual keys:
#
#   sudo bash -c 'echo -n "YOUR_KEY" > /etc/credstore/yt_key'
#   sudo bash -c 'echo -n "YOUR_KEY" > /etc/credstore/tw_key'
#   sudo bash -c 'echo -n "YOUR_KEY" > /etc/credstore/kick_key'
#   sudo chmod 600 /etc/credstore/*

YT_KEY=rtmp://a.rtmp.youtube.com/live2/YOUR_YT_KEY
TW_KEY=rtmp://live.twitch.tv/app/YOUR_TW_KEY
KICK_KEY=rtmp://fa723fc1b171.global-contribute.live-video.net/app/YOUR_KICK_KEY
