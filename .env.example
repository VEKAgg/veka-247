# Stream Keys Template
# Store ONLY the stream key (no rtmp:// URL prefix) in /etc/credstore/:
#
#   sudo bash -c 'echo -n "live_XXXX_YYYYY" > /etc/credstore/tw_key'
#   sudo bash -c 'echo -n "xxxx-xxxx-xxxx-xxxx" > /etc/credstore/yt_key'
#   sudo bash -c 'echo -n "sk_XX_XXXXXXXXX" > /etc/credstore/kick_key'
#   sudo chmod 600 /etc/credstore/*
#
# The RTMP base URLs are built into playout.sh — only the key goes here.

TW_KEY=live_YOUR_TWITCH_STREAM_KEY
YT_KEY=YOUR_YOUTUBE_STREAM_KEY
KICK_KEY=YOUR_KICK_STREAM_KEY
