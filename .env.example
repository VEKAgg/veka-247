# 247live does NOT use .env files for stream keys.
#
# Keys are stored in /etc/credstore/ (root-owned, chmod 600) and passed
# to the service at runtime via systemd LoadCredential. They are never
# in scripts, environment files, or version control.
#
# ── Setup ─────────────────────────────────────────────────────────────────────
#
# Twitch (required):
#   sudo bash -c 'printf "%s" "live_YOUR_KEY_HERE" > /etc/credstore/tw_key'
#   sudo chmod 600 /etc/credstore/tw_key
#
# YouTube (optional — leave empty to disable):
#   sudo bash -c 'printf "%s" "YOUR_YT_KEY" > /etc/credstore/yt_key'
#   sudo chmod 600 /etc/credstore/yt_key
#
# Kick (optional — leave empty to disable):
#   sudo bash -c 'printf "%s" "YOUR_KICK_KEY" > /etc/credstore/kick_key'
#   sudo chmod 600 /etc/credstore/kick_key
#
# ── Notes ─────────────────────────────────────────────────────────────────────
# - Use printf (not echo) to avoid a trailing newline in the key file
# - Key only — no rtmp:// prefix, no quotes, no trailing characters
# - An empty key file means that platform is silently skipped at stream start
# - After changing a key: sudo systemctl restart playout
#
# ── Where to find your keys ───────────────────────────────────────────────────
# Twitch:  Dashboard → Settings → Stream → Primary Stream Key
# YouTube: YouTube Studio → Go Live → Stream tab → Stream Key
# Kick:    Creator Dashboard → Settings → Stream → Stream Key
