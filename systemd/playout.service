[Unit]
Description=24/7 Live Playout Stream
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=vortek
Group=vortek

LoadCredential=tw_key:/etc/credstore/tw_key
LoadCredential=yt_key:/etc/credstore/yt_key
LoadCredential=kick_key:/etc/credstore/kick_key

RuntimeDirectory=247live
RuntimeDirectoryMode=0755

Restart=on-failure
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=30

ExecStart=/opt/247live/scripts/playout.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=247live

[Install]
WantedBy=multi-user.target
