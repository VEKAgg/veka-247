# veka-247 — environment config
# Copy this to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# .env is gitignored — your keys never leave the server.

# ── Stream keys ──────────────────────────────────────────────────────────────
# Twitch stream key from: Twitch → Creator Dashboard → Settings → Stream
TWITCH_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Uncomment and fill these if you want to stream to YouTube or Kick too:
# YOUTUBE_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
# KICK_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Infrastructure ────────────────────────────────────────────────────────────
TRUENAS_IP=192.168.1.98
VM_IP=192.168.1.6
CLIP_DIR=/srv/clips
