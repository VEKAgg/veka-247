# veka-247 — infrastructure reference
# Copy to .env if you want to use these values in scripts

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=veka
POSTGRES_USER=veka
POSTGRES_PASSWORD=veka_secret

# ── Infrastructure ───────────────────────────────────────────────────────────
TRUENAS_IP=192.168.1.98
VM_IP=192.168.1.6
CLIP_DIR=/srv/clips

# ── Platform RTMP URLs ───────────────────────────────────────────────────────
# Twitch Mumbai: rtmp://aps30.contribute.live-video.net/app/{KEY}
# YouTube:       rtmp://a.rtmp.youtube.com/live2/{KEY}
# Kick:          rtmps://{account-id}.global-contribute.live-video.net:443/app/{KEY}

# ── Services ─────────────────────────────────────────────────────────────────
# Dashboard:      http://<VM_IP>:3000
# Backend API:    http://<VM_IP>:8000
# ffplayout TTTR: http://<VM_IP>:8787
# ffplayout IGFV: http://<VM_IP>:8788
# ffplayout FH6:  http://<VM_IP>:8789
# ffplayout VA:   http://<VM_IP>:8790
# Restreamer:     http://<VM_IP>:8080
# MediaMTX HLS:   http://<VM_IP>:8888
# IRL Ingest:     rtmp://<VM_IP>:1935/live/irl
